{
  "manifest_version": 3,
  "name": "SageShield - AI Phishing Extension",
  "version": "1.0",
  "description": "Quickly check emails for suspicious phishing language and links.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "host_permissions": [
    "https://*.onrender.com/*",
    "http://127.0.0.1:5000/*"
  ]
}